{
  "name": "@plomus/contracts",
  "version": "0.1.0",
  "private": false,
  "description": "Public contract registry for Plomus operating systems.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/plomus-company/plomus-contracts.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "contracts",
    "dist",
    "schemas",
    "README.md"
  ],
  "exports": {
    ".": "./dist/plomus-contracts.json",
    "./base": "./contracts/v1/base.json",
    "./presets": "./contracts/v1/presets.json",
    "./review-rules": "./contracts/v1/review-rules.json",
    "./workflows": "./contracts/v1/workflows.json",
    "./skills": "./dist/plomus-skills.json",
    "./skills/base": "./contracts/skills/v1/base.json",
    "./skills/catalog": "./contracts/skills/v1/catalog.json",
    "./skills/proxy-routes": "./contracts/skills/v1/proxy-routes.json",
    "./skills/credentials": "./contracts/skills/v1/credentials.json",
    "./skills/data-sources": "./contracts/skills/v1/data-sources.json",
    "./benchmarks": "./dist/plomus-benchmarks.json",
    "./benchmarks/base": "./contracts/benchmarks/v1/base.json",
    "./benchmarks/models": "./contracts/benchmarks/v1/models.json",
    "./benchmarks/metrics": "./contracts/benchmarks/v1/metrics.json",
    "./benchmarks/targets": "./contracts/benchmarks/v1/targets.json",
    "./benchmarks/results": "./contracts/benchmarks/v1/results.json",
    "./benchmarks/rollups": "./contracts/benchmarks/v1/rollups.json",
    "./distribution": "./dist/plomus-distribution.json",
    "./distribution/base": "./contracts/distribution/v1/base.json",
    "./distribution/presets": "./contracts/distribution/v1/presets.json",
    "./distribution/fields": "./contracts/distribution/v1/fields.json",
    "./distribution/experimental-rules": "./contracts/distribution/v1/experimental-rules.json",
    "./protocol": "./dist/plomus-protocol.json",
    "./protocol/base": "./contracts/protocol/v1/base.json",
    "./protocol/endpoints": "./contracts/protocol/v1/endpoints.json",
    "./protocol/sync-event": "./contracts/protocol/v1/sync-event.json",
    "./protocol/payloads": "./contracts/protocol/v1/payloads.json",
    "./protocol/telegram": "./contracts/protocol/v1/telegram.json",
    "./platform": "./dist/plomus-platform.json",
    "./platform/base": "./contracts/platform/v1/base.json",
    "./platform/frontmatter": "./contracts/platform/v1/frontmatter.json",
    "./platform/event-types": "./contracts/platform/v1/event-types.json",
    "./platform/error-codes": "./contracts/platform/v1/error-codes.json",
    "./governance": "./dist/plomus-governance.json",
    "./governance/base": "./contracts/governance/v1/base.json",
    "./governance/roles": "./contracts/governance/v1/roles.json",
    "./governance/approval": "./contracts/governance/v1/approval.json",
    "./governance/execution-lifecycle": "./contracts/governance/v1/execution-lifecycle.json",
    "./governance/model-routing": "./contracts/governance/v1/model-routing.json",
    "./gameops": "./dist/plomus-gameops.json",
    "./gameops/base": "./contracts/gameops/v1/base.json",
    "./gameops/adapters": "./contracts/gameops/v1/adapters.json",
    "./gameops/agents": "./contracts/gameops/v1/agents.json",
    "./gameops/playbooks": "./contracts/gameops/v1/playbooks.json",
    "./gameops/fields": "./contracts/gameops/v1/fields.json"
  },
  "scripts": {
    "format:contracts": "node scripts/format-contracts.mjs",
    "format:check": "node scripts/format-contracts.mjs --check",
    "validate": "pnpm run validate:commerce && pnpm run validate:skills && pnpm run validate:benchmarks && pnpm run validate:distribution && pnpm run validate:protocol && pnpm run validate:platform && pnpm run validate:governance && pnpm run validate:gameops && pnpm run validate:cross-domain",
    "validate:commerce": "node scripts/validate.mjs",
    "validate:skills": "node scripts/validate-skills.mjs",
    "validate:benchmarks": "node scripts/validate-benchmarks.mjs",
    "validate:distribution": "node scripts/validate-distribution.mjs",
    "validate:protocol": "node scripts/validate-protocol.mjs",
    "validate:platform": "node scripts/validate-platform.mjs",
    "validate:governance": "node scripts/validate-governance.mjs",
    "validate:gameops": "node scripts/validate-gameops.mjs",
    "validate:cross-domain": "node scripts/validate-cross-domain.mjs",
    "build": "pnpm run build:commerce && pnpm run build:skills && pnpm run build:benchmarks && pnpm run build:distribution && pnpm run build:protocol && pnpm run build:platform && pnpm run build:governance && pnpm run build:gameops && pnpm run build:index",
    "build:commerce": "node scripts/build.mjs",
    "build:skills": "node scripts/build-skills.mjs",
    "build:benchmarks": "node scripts/build-benchmarks.mjs",
    "build:distribution": "node scripts/build-distribution.mjs",
    "build:protocol": "node scripts/build-protocol.mjs",
    "build:platform": "node scripts/build-platform.mjs",
    "build:governance": "node scripts/build-governance.mjs",
    "build:gameops": "node scripts/build-gameops.mjs",
    "build:index": "node scripts/build-index.mjs",
    "summary": "node scripts/summary.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:watch": "node --test --watch tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"scripts/*.mjs\" --test-coverage-include=\"tests/*.mjs\" --test-coverage-include=\"tests/helpers/*.mjs\" tests/*.test.mjs",
    "check:update": "pnpm run format:check && pnpm run validate && pnpm run summary",
    "check:ci": "pnpm run check:update && pnpm run build && pnpm run test",
    "ci": "pnpm run check:ci",
    "prepack": "pnpm run build",
    "import:commerce-ai-os": "node tools/import-from-commerce-ai-os.mjs",
    "import:k-skill": "node tools/import-from-k-skill.mjs",
    "import:distribution": "node tools/import-from-distribution-ai-os.mjs",
    "import:protocol": "node tools/import-protocol.mjs",
    "import:platform": "node tools/import-platform.mjs",
    "import:governance": "node tools/import-governance.mjs",
    "import:gameops": "node tools/import-gameops.mjs",
    "generate:benchmarks": "node tools/generate-benchmarks.mjs",
    "summary:benchmarks": "node scripts/summary-benchmarks.mjs",
    "experiment": "node tools/run-experiment.mjs"
  }
}
