{
  "name": "@plomus/contracts",
  "version": "0.1.0",
  "private": false,
  "description": "Public contract registry for Plomus operating systems.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/plomus-company/plomus-contracts.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "contracts",
    "dist",
    "schemas",
    "README.md"
  ],
  "exports": {
    ".": "./dist/plomus-contracts.json",
    "./base": "./contracts/v1/base.json",
    "./presets": "./contracts/v1/presets.json",
    "./review-rules": "./contracts/v1/review-rules.json",
    "./workflows": "./contracts/v1/workflows.json"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:ci": "pnpm run validate && pnpm run build && pnpm run test",
    "ci": "pnpm run check:ci",
    "prepack": "pnpm run build",
    "import:commerce-ai-os": "node tools/import-from-commerce-ai-os.mjs"
  }
}
