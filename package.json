{
  "name": "@plomus/contracts",
  "version": "0.1.0",
  "private": false,
  "description": "Public contract registry for Plomus operating systems.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/plomus-company/plomus-contracts.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "contracts",
    "dist",
    "schemas",
    "README.md"
  ],
  "exports": {
    ".": "./dist/plomus-contracts.json",
    "./base": "./contracts/v1/base.json",
    "./presets": "./contracts/v1/presets.json",
    "./review-rules": "./contracts/v1/review-rules.json",
    "./workflows": "./contracts/v1/workflows.json",
    "./skills": "./dist/plomus-skills.json",
    "./skills/base": "./contracts/skills/v1/base.json",
    "./skills/catalog": "./contracts/skills/v1/catalog.json",
    "./skills/proxy-routes": "./contracts/skills/v1/proxy-routes.json",
    "./skills/credentials": "./contracts/skills/v1/credentials.json",
    "./skills/data-sources": "./contracts/skills/v1/data-sources.json",
    "./benchmarks": "./dist/plomus-benchmarks.json",
    "./benchmarks/base": "./contracts/benchmarks/v1/base.json",
    "./benchmarks/models": "./contracts/benchmarks/v1/models.json",
    "./benchmarks/metrics": "./contracts/benchmarks/v1/metrics.json",
    "./benchmarks/targets": "./contracts/benchmarks/v1/targets.json",
    "./benchmarks/results": "./contracts/benchmarks/v1/results.json",
    "./benchmarks/rollups": "./contracts/benchmarks/v1/rollups.json"
  },
  "scripts": {
    "format:contracts": "node scripts/format-contracts.mjs",
    "format:check": "node scripts/format-contracts.mjs --check",
    "validate": "pnpm run validate:commerce && pnpm run validate:skills && pnpm run validate:benchmarks",
    "validate:commerce": "node scripts/validate.mjs",
    "validate:skills": "node scripts/validate-skills.mjs",
    "validate:benchmarks": "node scripts/validate-benchmarks.mjs",
    "build": "pnpm run build:commerce && pnpm run build:skills && pnpm run build:benchmarks",
    "build:commerce": "node scripts/build.mjs",
    "build:skills": "node scripts/build-skills.mjs",
    "build:benchmarks": "node scripts/build-benchmarks.mjs",
    "summary": "node scripts/summary.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:update": "pnpm run format:check && pnpm run validate && pnpm run summary",
    "check:ci": "pnpm run check:update && pnpm run build && pnpm run test",
    "ci": "pnpm run check:ci",
    "prepack": "pnpm run build",
    "import:commerce-ai-os": "node tools/import-from-commerce-ai-os.mjs",
    "import:k-skill": "node tools/import-from-k-skill.mjs",
    "generate:benchmarks": "node tools/generate-benchmarks.mjs"
  }
}
