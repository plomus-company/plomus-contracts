{
  "schemaVersion": "1.0.0",
  "workflows": [
    {
      "workflowId": "contract-review",
      "label": "계약 검토",
      "reviewScope": "CONTRACT",
      "reviewType": "WORKFLOW",
      "targetFolders": [
        "25-projects",
        "26-contracts",
        "35-partners"
      ],
      "enabledRuleIds": [
        "SI_CONTRACT_MISSING",
        "PARTNER_CONTRACT_MISSING"
      ],
      "safety": {
        "executionClass": "LOCAL_WRITE",
        "riskLevel": "HIGH",
        "externalAccess": "NONE",
        "requiresApprovalBeforeApply": true,
        "sideEffects": [
          "CREATE_COMMERCE_REVIEW",
          "CREATE_AI_RECOMMENDATION",
          "CREATE_CHANGE_PLAN",
          "CREATE_TASK",
          "CREATE_SYNC_EVENT"
        ],
        "notes": "Review workflow는 로컬 검토 산출물과 변경 계획만 생성하며, 대상 파일 반영은 승인된 APPLY_CHANGE_PLAN에서만 수행합니다."
      }
    }
  ]
}
