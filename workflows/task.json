{
  "schemaVersion": "1.0.0",
  "workflows": [
    {
      "workflowId": "task-approved",
      "label": "승인 작업 검토",
      "reviewScope": "TASK",
      "reviewType": "WORKFLOW",
      "targetFolders": [
        "65-change-plans",
        "70-tasks"
      ],
      "enabledRuleIds": [
        "TASK_OVERDUE",
        "CHANGE_PLAN_STALE",
        "TASK_DONE_CLEANUP"
      ],
      "safety": {
        "executionClass": "LOCAL_WRITE",
        "riskLevel": "LOW",
        "externalAccess": "NONE",
        "requiresApprovalBeforeApply": true,
        "sideEffects": [
          "CREATE_COMMERCE_REVIEW",
          "CREATE_AI_RECOMMENDATION",
          "CREATE_CHANGE_PLAN",
          "CREATE_TASK",
          "CREATE_SYNC_EVENT"
        ],
        "notes": "Review workflow는 로컬 검토 산출물과 변경 계획만 생성하며, 대상 파일 반영은 승인된 APPLY_CHANGE_PLAN에서만 수행합니다."
      }
    }
  ]
}
