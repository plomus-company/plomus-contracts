{
  "schemaVersion": "1.0.0",
  "workflows": [
    {
      "workflowId": "si-project-review",
      "label": "SI 프로젝트 검토",
      "reviewScope": "SI_PROJECT",
      "reviewType": "WORKFLOW",
      "targetFolders": [
        "25-projects",
        "27-deliverables",
        "28-maintenance",
        "50-settlements"
      ],
      "enabledRuleIds": [
        "SI_CONTRACT_MISSING",
        "SI_DELIVERABLE_DELAY",
        "SI_MAINTENANCE_PENDING",
        "SI_INVOICE_PENDING"
      ],
      "safety": {
        "executionClass": "LOCAL_WRITE",
        "riskLevel": "HIGH",
        "externalAccess": "NONE",
        "requiresApprovalBeforeApply": true,
        "sideEffects": [
          "CREATE_COMMERCE_REVIEW",
          "CREATE_AI_RECOMMENDATION",
          "CREATE_CHANGE_PLAN",
          "CREATE_TASK",
          "CREATE_SYNC_EVENT"
        ],
        "notes": "Review workflow는 로컬 검토 산출물과 변경 계획만 생성하며, 대상 파일 반영은 승인된 APPLY_CHANGE_PLAN에서만 수행합니다."
      }
    }
  ]
}
